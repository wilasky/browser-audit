{
  "version": "1.0.0",
  "description": "Heuristic mapping cookie names to inferred purpose. Order matters: more specific patterns first. The compliance probe applies these regexes against each cookie name to bucket it (analytics / ads / tracking / session / functional / ux). Inferred — never assume 100% accuracy without an external vendor database.",
  "patterns": [
    { "regex": "^_ga(_|$)", "purpose": "analytics", "vendor": "Google Analytics" },
    { "regex": "^_gid$",    "purpose": "analytics", "vendor": "Google Analytics" },
    { "regex": "^_gat",     "purpose": "analytics", "vendor": "Google Analytics" },
    { "regex": "^_gcl_",    "purpose": "ads",       "vendor": "Google Ads (conversion linker)" },
    { "regex": "^IDE$",     "purpose": "ads",       "vendor": "Google DoubleClick" },
    { "regex": "^NID$",     "purpose": "ads",       "vendor": "Google" },
    { "regex": "^DSID$",    "purpose": "ads",       "vendor": "Google" },
    { "regex": "^cto_",     "purpose": "ads",       "vendor": "Criteo" },
    { "regex": "^_uetsid",  "purpose": "ads",       "vendor": "Microsoft Bing Ads" },
    { "regex": "^_uetvid",  "purpose": "ads",       "vendor": "Microsoft Bing Ads" },
    { "regex": "^_fbp$",    "purpose": "ads",       "vendor": "Meta / Facebook Pixel" },
    { "regex": "^fr$",      "purpose": "ads",       "vendor": "Meta / Facebook" },
    { "regex": "^_pin_",    "purpose": "ads",       "vendor": "Pinterest" },
    { "regex": "^muc_ads$", "purpose": "ads",       "vendor": "X / Twitter" },
    { "regex": "^_tt_enable_cookie", "purpose": "ads", "vendor": "TikTok" },
    { "regex": "^anj$",     "purpose": "ads",       "vendor": "AppNexus / Xandr" },
    { "regex": "^uuid2$",   "purpose": "tracking",  "vendor": "AppNexus / Xandr" },
    { "regex": "^id5",      "purpose": "tracking",  "vendor": "ID5" },
    { "regex": "^_lr_",     "purpose": "tracking",  "vendor": "LiveRamp" },
    { "regex": "^_pubcid",  "purpose": "tracking",  "vendor": "Prebid Shared ID" },
    { "regex": "^panoramaId", "purpose": "tracking", "vendor": "LiveRamp" },
    { "regex": "^taboola_", "purpose": "ads",       "vendor": "Taboola" },
    { "regex": "^_outbrain", "purpose": "ads",      "vendor": "Outbrain" },
    { "regex": "^OptanonConsent$",      "purpose": "consent", "vendor": "OneTrust" },
    { "regex": "^OptanonAlertBoxClosed$","purpose": "consent","vendor": "OneTrust" },
    { "regex": "^didomi_token$",        "purpose": "consent", "vendor": "Didomi" },
    { "regex": "^euconsent",            "purpose": "consent", "vendor": "TCF Consent" },
    { "regex": "^_iub_cs",              "purpose": "consent", "vendor": "iubenda" },
    { "regex": "^cmplz_",               "purpose": "consent", "vendor": "Complianz" },
    { "regex": "^cookielawinfo-",       "purpose": "consent", "vendor": "CookieYes" },
    { "regex": "^CookieConsent$",       "purpose": "consent", "vendor": "Cookiebot" },
    { "regex": "^uid$",        "purpose": "tracking",  "vendor": null },
    { "regex": "^uuid$",       "purpose": "tracking",  "vendor": null },
    { "regex": "^visitor_",    "purpose": "tracking",  "vendor": null },
    { "regex": "^_cid$",       "purpose": "tracking",  "vendor": null },
    { "regex": "sync$",        "purpose": "tracking",  "vendor": null },
    { "regex": "^(session|sid|sess|jsessionid|asp\\.net_sessionid|phpsessid|connect\\.sid)$", "purpose": "session", "vendor": null, "sensitive": true },
    { "regex": "^(auth|access_token|refresh_token|jwt|id_token|bearer)", "purpose": "auth", "vendor": null, "sensitive": true },
    { "regex": "^(csrf|xsrf|_csrf|x-csrf-token)", "purpose": "security", "vendor": null, "sensitive": true },
    { "regex": "^(remember_token|remember_me)",   "purpose": "auth",     "vendor": null, "sensitive": true },
    { "regex": "(locale|lang|country|currency)$", "purpose": "ux",       "vendor": null },
    { "regex": "(theme|darkmode|color_scheme)$",  "purpose": "ux",       "vendor": null },
    { "regex": "(consent|gdpr|cmp)",              "purpose": "consent",  "vendor": null }
  ],
  "purposeLabels": {
    "analytics":  { "es": "Analítica",       "en": "Analytics" },
    "ads":        { "es": "Publicidad",      "en": "Advertising" },
    "tracking":   { "es": "Tracking",        "en": "Tracking" },
    "session":    { "es": "Sesión",          "en": "Session" },
    "auth":       { "es": "Autenticación",   "en": "Authentication" },
    "security":   { "es": "Seguridad",       "en": "Security" },
    "consent":    { "es": "Consentimiento",  "en": "Consent" },
    "ux":         { "es": "UX",              "en": "UX" },
    "unknown":    { "es": "Desconocido",     "en": "Unknown" }
  }
}
